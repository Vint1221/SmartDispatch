# Local Windows run uses SQLite; no Docker/PostgreSQL is required.
DATABASE_URL=sqlite:///./smart_dispatch.db
TEAM_NAME=Smart Dispatch
APP_VERSION=1.0.0

# Docker deployment can override DATABASE_URL with PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/smart_dispatch
# POSTGRES_DB=smart_dispatch
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
